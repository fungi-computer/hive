+test("derived terrain cover without authored hit geometry does not swallow actor clicks", () => {
+  const fixture = createMixedRenderFixture("north", "north");
+  const cover = fixture.grass[0];
+  assert.equal(cover.contains, undefined, "the atlas batching quad is not a cover hit silhouette");
+  const actor = Object.freeze({
+    id: "actor-on-cover", part: "body", role: "actor", renderPass: "opaque",
+    attachment: Object.freeze({ kind: "supported", support: null, feet: cover.attachment.point }),
+    moving: true, pickable: true, visible: true, contains: () => true,
+  });
+  const supportedCover = Object.freeze({ ...cover, attachment: Object.freeze({
+    ...cover.attachment,
+    supports: Object.freeze(cover.supportIds.map(() => Object.freeze([1, 0, 1]))),
+  }) });
+  const { records } = compileVoxelDrawStream([actor, supportedCover], {
+    direction: fixture.projection.direction,
+    verticalMetres: fixture.verticalMetres,
+  });
+  assert.equal(pickVoxelDrawRecord(records, { x: 0, y: 0 }).target, actor.id);
+});
